<?xml version="1.0" encoding="UTF-8"?>

<!-- Enhanced SUMO traffic light configuration for improved left/right turn lane management -->
<!-- Generated with optimized phases for dedicated turning movements -->

<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">
    
    <!-- Main intersection traffic light - Fixed for your original 24-character state length -->
    <tlLogic id="E3" type="static" programID="0" offset="0">
        
        <!-- Phase 1: North-South through + protected left turns -->
        <phase duration="35" state="GGGGggrrrrrrGGGggrrrrrr"/>
        
        <!-- Phase 2: North-South yellow transition -->
        <phase duration="4" state="yyyyggrrrrrryyyggrrrrrrr"/>
        
        <!-- Phase 3: East-West through + protected left turns -->
        <phase duration="35" state="rrrrrrGGGGggrrrrGGGGgg"/>
        
        <!-- Phase 4: East-West yellow transition -->
        <phase duration="4" state="rrrrrryyyyygrrrrryyyygg"/>
        
    </tlLogic>
    
    <!-- Alternative: More sophisticated turn management -->
    <tlLogic id="E3" type="static" programID="1" offset="0">
        
        <!-- Phase 1: North-South through with permissive left -->
        <phase duration="30" state="GGGggrrrrrrrGGGggrrrrrrr"/>
        
        <!-- Phase 2: North-South protected left only -->
        <phase duration="8" state="rrrGGrrrrrrrrrGGrrrrrrrr"/>
        
        <!-- Phase 3: North-South yellow -->
        <phase duration="3" state="rrryyrrrrrrrrrryyrrrrrrr"/>
        
        <!-- Phase 4: East-West through with permissive left -->
        <phase duration="30" state="rrrrrrrGGGggrrrrGGGgg"/>
        
        <!-- Phase 5: East-West protected left only -->
        <phase duration="8" state="rrrrrrrrrrGGrrrrrrrGG"/>
        
        <!-- Phase 6: East-West yellow -->
        <phase duration="3" state="rrrrrrrrrryyrrrrrrryy"/>
        
    </tlLogic>
    
    <!-- Detectors for actuated control (adjust lane names to match your network) -->
    <inductionLoop id="det_north_through" lane="north_through_0" pos="100" freq="60" file="detector_output.xml"/>
    <inductionLoop id="det_south_through" lane="south_through_0" pos="100" freq="60" file="detector_output.xml"/>
    <inductionLoop id="det_east_through" lane="east_through_0" pos="100" freq="60" file="detector_output.xml"/>
    <inductionLoop id="det_west_through" lane="west_through_0" pos="100" freq="60" file="detector_output.xml"/>
    
    <!-- Left turn detectors -->
    <inductionLoop id="det_north_left" lane="north_left_0" pos="50" freq="60" file="detector_output.xml"/>
    <inductionLoop id="det_south_left" lane="south_left_0" pos="50" freq="60" file="detector_output.xml"/>
    <inductionLoop id="det_east_left" lane="east_left_0" pos="50" freq="60" file="detector_output.xml"/>
    <inductionLoop id="det_west_left" lane="west_left_0" pos="50" freq="60" file="detector_output.xml"/>
    
</additional>